le# Configuration serveur
PORT=5000
NODE_ENV=production

# Base de données MongoDB (MongoDB Atlas recommandé)
MONGODB_URI=mongodb+srv://<utilisateur>:<motdepasse>@cluster0.xxxxx.mongodb.net/nizar_stock?retryWrites=true&w=majority

# Secret JWT (changez ceci en production !)
JWT_SECRET=nizar-transport-secret-key-2026-changez-moi

# URL du frontend (mobile PWA et desktop)
FRONTEND_URL=https://votre-domaine.com

# CORS
CORS_ORIGIN=*